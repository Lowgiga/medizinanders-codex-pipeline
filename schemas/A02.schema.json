{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medizinanders.local/schemas/A02.schema.json",
  "title": "A02 – Quellenpaket",
  "description": "Strukturprüfung; semantische und artefaktübergreifende Prüfungen erfolgen zusätzlich in medizinanders.validation.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    {
      "type": "object",
      "properties": {
        "artefakt_id": {
          "const": "A02"
        },
        "inhalt": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/source"
              },
              "minItems": 1
            },
            "suchprotokoll": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            },
            "gegenbelege": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            },
            "korrekturen_retraktionen": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": [
            "sources",
            "suchprotokoll",
            "gegenbelege",
            "korrekturen_retraktionen"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "x-abhaengigkeiten": [
    "A01"
  ]
}

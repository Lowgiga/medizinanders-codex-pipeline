{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medizinanders.local/schemas/A04.schema.json",
  "title": "A04 – Dramaturgie und Zeitstruktur",
  "description": "Strukturprüfung; semantische und artefaktübergreifende Prüfungen erfolgen zusätzlich in medizinanders.validation.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    {
      "type": "object",
      "properties": {
        "artefakt_id": {
          "const": "A04"
        },
        "inhalt": {
          "type": "object",
          "properties": {
            "profil": {
              "const": "MA-SHORT-58-v1.0"
            },
            "abschnitte": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "funktion": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "start_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 58000
                  },
                  "ende_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 58000
                  }
                },
                "required": [
                  "funktion",
                  "start_ms",
                  "ende_ms"
                ],
                "additionalProperties": false
              },
              "minItems": 7,
              "maxItems": 7
            },
            "dramaturgie": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "object",
                  "minProperties": 1
                }
              ]
            },
            "cta_anzahl": {
              "const": 1
            }
          },
          "required": [
            "profil",
            "abschnitte",
            "dramaturgie",
            "cta_anzahl"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "x-abhaengigkeiten": [
    "A03"
  ]
}
